----------------------------------------------------------------
-- 4. MANEJO INTELIGENTE DE MASCOTAS (HASTA 12 SLOTS Y RELLENO)
----------------------------------------------------------------
local FarmPetsPriority = {
    "Swift Samurai",
    "Señor Supremo Omega", "Omega Overlord",
    "Perro de núcleo de energía", "Energy Core Dog",
    "Rare Boss Pet", "Mascota de jefe raro"
}

local RebirthPetsPriority = {
    "Hidra de titanio", "Titanium Hydra",
    "Soberano tribal", "Tribal Overlord"
}

local function unequipAllPets()
    local petsFolder = LocalPlayer:FindFirstChild("petsFolder")
    if not petsFolder then return end
    for _, folder in pairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in pairs(folder:GetChildren()) do
                ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet)
            end
        end
    end
    task.wait(0.05)
end

local function equipUpTo12Slots(petPriorityList)
    local petsFolder = LocalPlayer:FindFirstChild("petsFolder")
    if not petsFolder then return end

    unequipAllPets()

    local equippedCount = 0
    local maxSlots = 12

    for _, targetName in ipairs(petPriorityList) do
        if equippedCount >= maxSlots then break end

        for _, folder in pairs(petsFolder:GetChildren()) do
            if folder:IsA("Folder") then
                for _, pet in pairs(folder:GetChildren()) do
                    if string.lower(pet.Name) == string.lower(targetName) then
                        if equippedCount < maxSlots then
                            ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", pet)
                            equippedCount = equippedCount + 1
                            task.wait(0.02)
                        else
                            break
                        end
                    end
                end
            end
        end
    end
end

----------------------------------------------------------------
-- 4.5. FUNCIÓN AUTO WEIGHT (EQUIPAR PESA AUTOMÁTICAMENTE)
----------------------------------------------------------------
local function equipNormalWeight()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    
    if backpack and character then
        local weightTool = backpack:FindFirstChild("Weight")
        local equippedWeight = character:FindFirstChild("Weight")
        
        if weightTool and not equippedWeight then
            weightTool.Parent = character
        end
    end
end

----------------------------------------------------------------
-- 5. REBIRTHS WITHOUT PACKS + BUCLE 100% AUTOMÁTICO
----------------------------------------------------------------
local leaderstats = LocalPlayer:WaitForChild("leaderstats")
local rebirthFolder = AutoFarm:AddFolder("Rebirths Sin Packs")

local targetRebirthAmount = nil
local farmingTarget = false
local repSpeed = 10

rebirthFolder:AddTextBox("Cantidad objetivo de Rebirths", function(value)
    local amount = tonumber(value) or 1
    local currentRebirths = leaderstats.Rebirths.Value
    if amount >= currentRebirths then
        targetRebirthAmount = amount
    end
end, {clear = false})

local targetRebirthToggle = rebirthFolder:AddSwitch("Iniciar Rebirths Automáticos", function(enabled)
    farmingTarget = enabled
    if enabled then
        task.spawn(function()
            -- ¡AQUÍ SE EJECUTA AUTOMÁTICAMENTE AL DARLE START!
            equipNormalWeight()
            equipUpTo12Slots(FarmPetsPriority)
            task.wait(0.2)
            
            while farmingTarget do
                local currentRebirths = leaderstats.Rebirths.Value
                local requiredStrength = 10000 + 5000 * currentRebirths

                if targetRebirthAmount and currentRebirths >= targetRebirthAmount then
                    targetRebirthToggle:Set(false)
                    farmingTarget = false
                    break
                end

                if leaderstats.Strength.Value >= requiredStrength then
                    -- 1. Equipa las mascotas de Rebirth (Hidra/Soberano) en los 12 slots
                    equipUpTo12Slots(RebirthPetsPriority)
                    task.wait(0.3)
                    
                    -- 2. Renace automáticamente
                    ReplicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest")
                    task.wait(0.8)
                    
                    -- 3. Vuelve a equipar la Pesa y las mascotas de Fuerza para el siguiente ciclo
                    equipNormalWeight()
                    equipUpTo12Slots(FarmPetsPriority)
                    task.wait(0.3)
                else
                    -- Asegura que la pesa siempre esté equipada mientras hace repeticiones
                    equipNormalWeight()

                    for i = 1, repSpeed do
                        if not farmingTarget then break end
                        if LocalPlayer:FindFirstChild("muscleEvent") then
                            LocalPlayer.muscleEvent:FireServer("rep")
                        end
                    end
                end

                task.wait(0.05)
            end
        end)
    end
end)

AutoFarm:AddButton("Equip Normal Weight (Manual)", function()
    equipNormalWeight()
end)

AutoFarm:AddButton("Equip Pets de Fuerza (Manual)", function()
    equipUpTo12Slots(FarmPetsPriority)
end)

AutoFarm:AddButton("Equip Pets de Rebirth (Manual)", function()
    equipUpTo12Slots(RebirthPetsPriority)
end)
