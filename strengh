local FarmPetsPriority = {
    "núcleo", 
    "nucleo", 
    "energía", 
    "energia", 
    "core", 
    "omega", 
    "samurai"
}

local RebirthPets = {"hidra", "hydra", "titanio", "titanium", "omega", "overlord"}
local MAX_EQUIP_PETS = 12

local function getPetsContainer()
    if LocalPlayer:FindFirstChild("petsFolder") then
        return LocalPlayer.petsFolder
    end
    for _, v in pairs(LocalPlayer:GetChildren()) do
        if v:IsA("Folder") and string.find(string.lower(v.Name), "pet") then
            return v
        end
    end
    return nil
end

local function unequipAllPets()
    local petsFolder = getPetsContainer()
    if not petsFolder then return end
    for _, folder in pairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            for _, pet in pairs(folder:GetChildren()) do
                ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", pet)
            end
        else
            ReplicatedStorage.rEvents.equipPetEvent:FireServer("unequipPet", folder)
        end
    end
    task.wait(0.15)
end

local function equipPetsWithPriority(petKeywords)
    local petsFolder = getPetsContainer()
    if not petsFolder then
        warn("[DEBUG]: No se encontró ninguna carpeta de mascotas en el jugador.")
        return
    end

    local allAvailablePets = {}

    for _, folder in pairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            for _, pet in pairs(folder:GetChildren()) do
                table.insert(allAvailablePets, pet)
            end
        else
            table.insert(allAvailablePets, folder)
        end
    end

    local sortedPetsToEquip = {}

    for _, keyword in ipairs(petKeywords) do
        for i = #allAvailablePets, 1, -1 do
            local pet = allAvailablePets[i]
            local petNameLower = string.lower(pet.Name)
            if string.find(petNameLower, string.lower(keyword)) then
                local alreadyAdded = false
                for _, p in ipairs(sortedPetsToEquip) do
                    if p == pet then alreadyAdded = true break end
                end
                
                if not alreadyAdded and #sortedPetsToEquip < MAX_EQUIP_PETS then
                    table.insert(sortedPetsToEquip, pet)
                end
            end
        end
    end

    if #sortedPetsToEquip < MAX_EQUIP_PETS then
        for _, pet in ipairs(allAvailablePets) do
            local alreadyAdded = false
            for _, p in ipairs(sortedPetsToEquip) do
                if p == pet then alreadyAdded = true break end
            end
            if not alreadyAdded and #sortedPetsToEquip < MAX_EQUIP_PETS then
                table.insert(sortedPetsToEquip, pet)
            end
        end
    end

    local equippedCount = 0
    for _, petToEquip in ipairs(sortedPetsToEquip) do
        if equippedCount >= MAX_EQUIP_PETS then break end
        ReplicatedStorage.rEvents.equipPetEvent:FireServer("equipPet", petToEquip)
        equippedCount = equippedCount + 1
        task.wait(0.04)
    end
end

